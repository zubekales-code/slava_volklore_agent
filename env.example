# Zkopíruj tento soubor jako ".env" a doplň skutečné hodnoty, pokud chceš
# skript zkoušet na vlastním počítači. Skutečný ".env" soubor se NIKDY
# nenahrává na GitHub (viz .gitignore) -- v GitHub Actions se tyhle
# hodnoty nastavují jako "Secrets", ne v souboru. Návod je v README.

OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
RESEND_API_KEY=
SUPADATA_API_KEY=

# Nepovinné -- funguje i bez toho (jen s nižším rychlostním limitem):
JINA_API_KEY=
